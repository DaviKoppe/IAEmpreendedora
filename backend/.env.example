# Copie este arquivo para backend/.env e ajuste os valores, se necessário.
# O arquivo .env não deve ser versionado. Todas as variáveis são opcionais
# no desenvolvimento local.

# ----------------------------------------------------------------------
# Banco de dados (SQLite)
# ----------------------------------------------------------------------
# Caminho do arquivo do banco. Sem esta variável, é usado backend/db.sqlite3.
# No Render ela é obrigatória e deve apontar para o disco persistente:
# SQLITE_DB_PATH=/var/data/db.sqlite3

# ----------------------------------------------------------------------
# Django (obrigatórias em produção)
# ----------------------------------------------------------------------
# DJANGO_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
